    "requestTime",
    "timezone",
    "locale",
    "contextManifest",
    "contextHash",
    "capabilities",
    "deadlineAt",
  ],
  "title": "IngressRequest",
  "type": "object",
}
`;

exports[`schema snapshots (breaking-change detection) > structuredError matches its committed snapshot 1`] = `
{
  "$id": "https://chatbot-contracts.appspine.internal/v1/structured-error.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine-readable error classification per the 024 plan §7.4. Never carries secrets, capability tokens, or raw prompt/tool payloads.",
  "properties": {
    "code": {
      "enum": [
        "BOT_DISABLED_OR_UNBOUND",
        "DEPLOYMENT_UNAVAILABLE",
        "INGRESS_AUTH_ERROR",
        "CLAIM_AUTH_ERROR",
        "CONTRACT_VALIDATION_ERROR",
        "ENDPOINT_UNAVAILABLE",
        "WORKFLOW_DEADLINE_EXCEEDED",
        "WORKFLOW_OR_MODEL_FAILURE",
        "MCP_PROTOCOL_ERROR",
        "MCP_AUTHORIZATION_ERROR",
        "MCP_DOMAIN_ERROR",
        "MCP_IDEMPOTENCY_CONFLICT",
        "ATTACHMENT_TRANSFER_ERROR",
        "ATTACHMENT_SCAN_REJECTED",
        "ATTACHMENT_PROMOTION_ERROR",
        "RICH_ACTION_VALIDATION_ERROR",
        "NO_DISPLAYABLE_CONTENT",
      ],
      "type": "string",
    },
    "details": {
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null",
        ],
      },
      "description": "Optional bounded, redacted structured detail. Never a raw payload dump.",
      "maxProperties": 20,
      "type": "object",
    },
    "message": {
      "description": "Safe-to-display summary. No secrets, no raw tool/model output.",
      "maxLength": 2000,
      "minLength": 1,
      "type": "string",
    },
    "retryable": {
      "type": "boolean",
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/contractVersion",
    },
  },
  "required": [
    "schemaVersion",
    "code",
    "message",
    "retryable",
  ],
  "title": "StructuredError",
  "type": "object",
}
`;

