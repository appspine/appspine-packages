{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appspine.dev/schemas/integration-contract-meta-schema.json",
  "title": "Appspine integration contract frontmatter",
  "type": "object",
  "required": [
    "type",
    "contract_kind",
    "contract_id",
    "version",
    "status",
    "interaction",
    "transport",
    "maintainer",
    "required_reviewers"
  ],
  "properties": {
    "type": { "const": "integration-contract" },
    "contract_kind": { "enum": ["capability", "binding"] },
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": { "enum": ["draft", "review", "approved", "deprecated"] },
    "interaction": { "enum": ["command", "query", "event"] },
    "transport": { "enum": ["http", "webhook", "message-broker"] },
    "provider": { "type": "string" },
    "producer": { "type": "string" },
    "callers": { "type": "array", "items": { "type": "string" } },
    "consumers": { "type": "array", "items": { "type": "string" } },
    "source_app": { "type": "string" },
    "destination_app": { "type": "string" },
    "capability_ref": {
      "type": "object",
      "required": ["contract_id", "version", "digest"],
      "properties": {
        "contract_id": { "type": "string" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "maintainer": { "type": "string", "minLength": 1 },
    "required_reviewers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "deprecated_at": { "type": "string", "format": "date-time" },
    "support_until": { "type": "string", "format": "date-time" },
    "implementation_status": {
      "enum": ["planned", "implemented", "verified", "disabled"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "contract_kind": { "const": "capability" } } },
      "then": {
        "anyOf": [
          { "required": ["provider"] },
          { "required": ["producer"] }
        ]
      }
    },
    {
      "if": { "properties": { "contract_kind": { "const": "binding" } } },
      "then": {
        "required": ["capability_ref", "source_app", "destination_app"]
      }
    }
  ],
  "additionalProperties": true
}
