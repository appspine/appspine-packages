{
  "name": "@appspine/preset-standard",
  "version": "2.0.0",
  "private": false,
  "description": "The standard Appspine capability set as one versioned preset: the plugins appspine-app-template wires by hand today, named once so an App does not restate them.",
  "files": [
    "dist",
    "appspine.preset.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appspine/appspine-packages.git",
    "directory": "packages/preset-standard"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./appspine.preset.json": "./appspine.preset.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@appspine/plugin-api": "^1.1.0"
  },
  "devDependencies": {
    "@appspine/plugin-api": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
