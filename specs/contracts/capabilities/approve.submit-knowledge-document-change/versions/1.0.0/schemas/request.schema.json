{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approve.submit-knowledge-document-change.request.1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentId", "baseRevision", "proposedRevision", "contentChecksum", "ownerDepartment", "summary", "actor"],
  "properties": {
    "documentId": { "type": "string", "minLength": 1, "maxLength": 200, "x-appspine-data-classification": "INTERNAL" },
    "baseRevision": { "type": "integer", "minimum": 0, "x-appspine-data-classification": "INTERNAL" },
    "proposedRevision": { "type": "integer", "minimum": 1, "x-appspine-data-classification": "INTERNAL" },
    "contentChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "x-appspine-data-classification": "INTERNAL" },
    "ownerDepartment": { "type": "string", "minLength": 1, "maxLength": 100, "x-appspine-data-classification": "INTERNAL" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500, "x-appspine-data-classification": "INTERNAL" },
    "actor": { "type": "object", "additionalProperties": false, "required": ["userId"], "properties": { "userId": { "type": "string", "minLength": 1, "x-appspine-data-classification": "PERSONAL" }, "displayName": { "type": "string", "maxLength": 200, "x-appspine-data-classification": "PERSONAL" } } }
  }
}
