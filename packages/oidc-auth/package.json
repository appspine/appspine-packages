{
  "name": "@appspine/oidc-auth",
  "version": "3.0.1",
  "private": false,
  "description": "OIDC interactive authentication for Appspine apps: JWKS/RS256 verification, (issuer, subject) identity mapping, JIT provisioning and inbound delegated (RFC 8693) trust profiles.",
  "files": [
    "dist",
    "prisma",
    "appspine.plugin.json",
    "plugin.js",
    "plugin.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appspine/appspine-packages.git",
    "directory": "packages/oidc-auth"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "default": "./dist/frontend.js"
    },
    "./appspine.plugin.json": "./appspine.plugin.json",
    "./prisma/oidc-identity.prisma": "./prisma/oidc-identity.prisma",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@appspine/frontend-shell": "workspace:*",
    "@appspine/plugin-api": "workspace:*",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "peerDependencies": {
    "@appspine/common": "^0.3.4",
    "@appspine/frontend-shell": "^1.0.0",
    "@appspine/plugin-host-nest": "^2.0.0",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/passport": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@appspine/frontend-shell": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@appspine/common": "workspace:*",
    "@appspine/frontend-shell": "workspace:*",
    "@appspine/plugin-host-nest": "workspace:*",
    "@appspine/plugin-testkit": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/passport": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
