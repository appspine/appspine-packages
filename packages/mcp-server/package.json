{
  "name": "@appspine/mcp-server",
  "version": "2.0.0-canary.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appspine/appspine-packages.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "CHANGELOG.md",
    "appspine.plugin.json",
    "plugin.js",
    "plugin.d.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./appspine.plugin.json": "./appspine.plugin.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@appspine/plugin-api": "workspace:*",
    "@appspine/plugin-host-nest": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "^4.12.34"
  },
  "peerDependencies": {
    "@appspine/plugin-host-nest": "^2.0.0",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "express": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@appspine/plugin-testkit": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/testing": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "express": "^5.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
