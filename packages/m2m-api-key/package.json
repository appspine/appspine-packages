  "devDependencies": {
    "@appspine/audit-log": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3",
