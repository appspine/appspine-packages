{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appspine.dev/schema/appspine.plugin.v1.json",
  "title": "appspine.plugin/v1",
  "description": "Runtime manifest contract shipped by @appspine/plugin-api (PL1-01/PL1-04). Every non-facet constraint is byte-identical to the PL0-05 frozen contract in knowledge/contracts/051-manifest-v1.schema.json; the backend and operations facet bodies are the concrete shapes PL1-06 owns, which PL0-05 deliberately left opaque. frontend/prisma/permissions facet bodies stay opaque here because PL3-02/PL2-06/PL2-07 own them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "cardinality",
    "engine",
    "provides",
    "requires",
    "facets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "appspine.plugin/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Plugin ID per knowledge/topics/051-pl0-package-classification.md registry."
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "cardinality": {
      "enum": ["singleton", "multiple"]
    },
    "distribution": {
      "enum": ["official", "app-local"],
      "description": "Required when replaces is present; only app-local plugins may replace a stock contribution. Package provenance must still be independently verified by the loader."
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appspinePluginApi", "node"],
      "properties": {
        "appspinePluginApi": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\^~]?[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\^~>=<]*[0-9]+(\\.[0-9]+)?(\\.[0-9]+)?"
        },
        "frameworks": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^appspine\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^appspine\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"
      },
      "uniqueItems": true
    },
    "optionalRequires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^appspine\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$"
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "description": "Plugin IDs this plugin cannot coexist with in the same App (e.g. oidc-auth declares conflicts: [\"local-auth\"]) — NOT capability names. See plan section 6.3.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "replaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin", "facet", "contribution", "reason"],
        "properties": {
          "plugin": {
            "type": "string",
            "minLength": 1
          },
          "facet": {
            "type": "string",
            "minLength": 1
          },
          "contribution": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configRef"],
      "properties": {
        "configRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "optionalFailurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolationBoundary", "degradedBehavior"],
      "properties": {
        "isolationBoundary": {
          "enum": ["instance"]
        },
        "degradedBehavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readiness", "catalog", "alert"],
          "properties": {
            "readiness": {
              "enum": ["degraded"]
            },
            "catalog": {
              "enum": ["degraded"]
            },
            "alert": {
              "enum": ["required"]
            }
          }
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "required", "secret"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modulePath", "exportName"],
          "properties": {
            "modulePath": {
              "type": "string",
              "minLength": 1,
              "description": "Package-relative path of the built CommonJS module that exports the Nest module/factory. Never imported by manifest parsing — build-time codegen and the host use it."
            },
            "exportName": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Named export of modulePath holding the Nest module class."
            },
            "factoryExportName": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Optional named export holding the plugin() / pluginAsync() factory pair (051 plan section 5.1)."
            },
            "global": {
              "type": "boolean",
              "description": "Deprecated escape hatch for capability modules still declared @Global(). Defaults to false; 051 decision 3 removes these."
            },
            "controllerRoutes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "description": "Route prefixes this facet contributes, used for duplicate-route detection (051 plan section 4.5)."
            },
            "providerTokens": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "description": "Stable provider tokens this facet registers, used for duplicate-token detection."
            },
            "workers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^appspine\\.[a-z0-9-]+\\.[a-z0-9-]+$"
              },
              "uniqueItems": true,
              "description": "Background worker names per the PL0-03 namespace rule appspine.<plugin-id>.<worker-name>."
            }
          }
        },
        "frontend": {
          "type": "object"
        },
        "prisma": {
          "type": "object",
          "description": "Prisma contribution. PL0-05 left this opaque and named PL2-06 as its owner; this is that shape. A model has exactly one owner, and every augmentation names the model it extends and the field it adds, because the composer has to write that field into the owner it does not belong to.",
          "additionalProperties": false,
          "properties": {
            "owns": {
              "description": "Models this plugin owns outright. No other plugin may own them.",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              },
              "uniqueItems": true
            },
            "ownsEnums": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9]*$"
              },
              "uniqueItems": true
            },
            "augments": {
              "description": "Fields this plugin adds to a model another plugin owns. `owner` names that plugin, so the declaration is checkable without resolving the graph first. `type` is what the composer writes into the owner model; it is optional only because PL0-05 froze this shape before PL2-06 needed it, and an augmentation without one cannot be composed - the composer says so by name.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["targetModel", "field", "owner"],
                "properties": {
                  "targetModel": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*$"
                  },
                  "field": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]*$"
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "augmentedBy": {
              "description": "Owner-side declaration of who may extend this plugin’s models. Documentation the composer checks against, so an augmentation nobody expected is visible in the owner.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["plugin", "field"],
                "properties": {
                  "plugin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]*$"
                  }
                }
              }
            },
            "schemaFragment": {
              "description": "Package-relative path to the .prisma file this plugin ships.",
              "type": "string",
              "minLength": 1
            },
            "schemaDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "permissions": {
          "type": "object",
          "description": "Permissions this plugin declares. PL0-05 left this opaque and named PL2-07 as its owner. An ID is immutable and namespaced to the declaring plugin: renaming one is a new ID plus an alias, never an edit, because roles, audit rows and customer policies all reference it.",
          "additionalProperties": false,
          "properties": {
            "definitions": {
              "description": "Either a bare ID - the shape PL0-05 froze, where the display name defaults to the ID - or an object carrying a display name, an alias, or a frontend-only marker.",
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
                      },
                      "displayName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": ["active", "retired"]
                      },
                      "aliasOf": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
                      },
                      "frontendOnly": {
                        "type": "boolean",
                        "description": "A visibility hint for the UI. Never an authorization decision."
                      }
                    }
                  }
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "healthIndicatorId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "description": "Catalog/health key contributed by this plugin."
            },
            "metricsPrefix": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "shutdownTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600000,
              "description": "Per-instance shutdown budget; the host falls back to its own default when absent."
            }
          }
        }
      }
    },
    "integrationContracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
