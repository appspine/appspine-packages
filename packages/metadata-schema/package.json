{
  "name": "@appspine/metadata-schema",
  "version": "0.2.22",
  "private": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "appspine.plugin.json",
    "plugin.js",
    "plugin.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appspine/appspine-packages.git",
    "directory": "packages/metadata-schema"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./appspine.plugin.json": "./appspine.plugin.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@appspine/common": "workspace:*",
    "@appspine/plugin-api": "workspace:*",
    "@appspine/plugin-host-nest": "workspace:*"
  },
  "peerDependencies": {
    "@appspine/plugin-host-nest": "^1.0.0",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "@appspine/m2m-api-key": "workspace:*",
    "@appspine/plugin-testkit": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
