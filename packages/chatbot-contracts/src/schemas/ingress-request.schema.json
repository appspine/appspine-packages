{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatbot-contracts.appspine.internal/v1/ingress-request.schema.json",
  "title": "IngressRequest",
  "description": "Chat -> n8n Webhook Trigger payload (024 plan §6.2). Every identity/time/origin/revision/capability value is server-generated by Chat; nothing here is frontend-supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "runId",
    "deployment",
    "botId",
    "channelId",
    "threadId",
    "rootMessageId",
    "trigger",
    "source",
    "requestTime",
    "timezone",
    "locale",
    "contextManifest",
    "contextHash",
    "capabilities",
    "deadlineAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "requestId": { "$ref": "common.schema.json#/$defs/uuid" },
    "runId": { "$ref": "common.schema.json#/$defs/uuid" },
    "deployment": { "$ref": "common.schema.json#/$defs/deploymentRevisionSnapshot" },
    "botId": { "$ref": "common.schema.json#/$defs/uuid" },
    "channelId": { "$ref": "common.schema.json#/$defs/uuid" },
    "threadId": { "$ref": "common.schema.json#/$defs/uuid" },
    "rootMessageId": { "$ref": "common.schema.json#/$defs/uuid" },
    "trigger": {
      "description": "Discriminated: a Bot Thread is started/continued either by a message or by a typed rich-content action. Both carry a stable ID and the revision they were evaluated against.",
      "oneOf": [{ "$ref": "#/$defs/messageTrigger" }, { "$ref": "#/$defs/actionTrigger" }]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "userId", "origin"],
      "properties": {
        "actorId": { "$ref": "common.schema.json#/$defs/uuid" },
        "userId": {
          "description": "Context/audit only — never an authorization identity for target apps (024 plan §8.1).",
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "origin": {
          "description": "A Bot can only ever be triggered by a real human acting through the Chat UI/API. CHAT_BOT, INCOMING_WEBHOOK, MCP and SYSTEM origins must never appear here — enforced by fixing this to a const, not just documenting it.",
          "const": "USER_UI"
        }
      }
    },
    "requestTime": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "timezone": { "$ref": "common.schema.json#/$defs/ianaTimezone" },
    "locale": { "$ref": "common.schema.json#/$defs/locale" },
    "contextManifest": { "$ref": "context-manifest.schema.json#" },
    "contextHash": { "$ref": "common.schema.json#/$defs/sha256Hex" },
    "attachments": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "attachment-manifest.schema.json#" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "completion"],
      "properties": {
        "claim": { "$ref": "common.schema.json#/$defs/opaqueCapabilityToken" },
        "completion": { "$ref": "common.schema.json#/$defs/opaqueCapabilityToken" },
        "attachment": { "$ref": "common.schema.json#/$defs/opaqueCapabilityToken" }
      }
    },
    "deadlineAt": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  },
  "$defs": {
    "messageTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "messageId", "messageRevisionId"],
      "properties": {
        "kind": { "const": "MESSAGE" },
        "messageId": { "$ref": "common.schema.json#/$defs/uuid" },
        "messageRevisionId": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    },
    "actionTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actionEventId", "actionId"],
      "properties": {
        "kind": { "const": "ACTION" },
        "actionEventId": { "$ref": "common.schema.json#/$defs/uuid" },
        "actionId": { "$ref": "common.schema.json#/$defs/uuid" }
      }
    }
  }
}
