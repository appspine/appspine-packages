{
  "name": "@appspine/plugin-api",
  "version": "1.0.0",
  "private": false,
  "description": "Appspine plugin contract: manifest v1 types and JSON Schema, stable capability tokens, definePlugin(), lifecycle/diagnostic contracts, manifest loader and dependency resolver.",
  "files": [
    "dist",
    "loader.js",
    "loader.d.ts",
    "resolver.js",
    "resolver.d.ts",
    "runtime.d.ts",
    "runtime.js",
    "schema.js",
    "schema.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appspine/appspine-packages.git",
    "directory": "packages/plugin-api"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./loader": {
      "types": "./dist/loader/index.d.ts",
      "default": "./dist/loader/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver/index.d.ts",
      "default": "./dist/resolver/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./schema/appspine.plugin.v1.json": "./dist/schema/appspine.plugin.v1.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
