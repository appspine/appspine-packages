// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`schema snapshots (breaking-change detection) > attachmentManifest matches its committed snapshot 1`] = `
{
  "$id": "https://chatbot-contracts.appspine.internal/v1/attachment-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Metadata + run-scoped download/upload capability for one attachment. Never carries the binary itself (024 plan §6.5).",
  "properties": {
    "attachmentId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "capability": {
      "$ref": "common.schema.json#/$defs/opaqueCapabilityToken",
    },
    "checksumSha256": {
      "$ref": "common.schema.json#/$defs/sha256Hex",
    },
    "direction": {
      "enum": [
        "INPUT",
        "OUTPUT",
      ],
      "type": "string",
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
    },
    "fileName": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string",
    },
    "mimeType": {
      "maxLength": 255,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+-]*/[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+-]*$",
      "type": "string",
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/contractVersion",
    },
    "sizeBytes": {
      "maximum": 536870912,
      "minimum": 0,
      "type": "integer",
    },
    "status": {
      "enum": [
        "STAGING",
        "SCANNING",
        "READY",
        "REJECTED",
        "EXPIRED",
      ],
      "type": "string",
    },
  },
  "required": [
    "schemaVersion",
    "attachmentId",
    "runId",
    "direction",
    "status",
    "mimeType",
    "sizeBytes",
    "checksumSha256",
    "capability",
    "expiresAt",
  ],
  "title": "AttachmentManifest",
  "type": "object",
}
`;

exports[`schema snapshots (breaking-change detection) > callbackChallenge matches its committed snapshot 1`] = `
{
  "$id": "https://chatbot-contracts.appspine.internal/v1/callback-challenge.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "No-side-effect challenge used by the safe Health Check to prove n8n can reach Chat's completion callback path (024 plan §5.4) without executing model/tool code.",
  "properties": {
    "challengeToken": {
      "$ref": "common.schema.json#/$defs/opaqueCapabilityToken",
    },
    "deploymentId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
    },
    "issuedAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/contractVersion",
    },
  },
  "required": [
    "schemaVersion",
    "deploymentId",
    "challengeToken",
    "issuedAt",
    "expiresAt",
  ],
  "title": "CallbackChallenge",
  "type": "object",
}
`;

exports[`schema snapshots (breaking-change detection) > claimRequest matches its committed snapshot 1`] = `
{
  "$id": "https://chatbot-contracts.appspine.internal/v1/claim-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Wrapper's first business action: attempt to claim a Run before any model/tool executes (024 plan §7.1). Authenticated by the claim capability from IngressRequest.capabilities.claim, not by this body.",
  "properties": {
    "claimedAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
    },
    "deploymentId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "executionId": {
      "$ref": "common.schema.json#/$defs/nonEmptyString",
      "description": "n8n execution ID attempting the claim.",
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/contractVersion",
    },
  },
  "required": [
    "schemaVersion",
    "requestId",
    "runId",
    "executionId",
    "deploymentId",
    "claimedAt",
  ],
  "title": "ClaimRequest",
  "type": "object",
}
`;

exports[`schema snapshots (breaking-change detection) > claimResponse matches its committed snapshot 1`] = `
{
  "$defs": {
