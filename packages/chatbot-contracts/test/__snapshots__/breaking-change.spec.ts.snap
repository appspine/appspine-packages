      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array",
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/contractVersion",
    },
  },
  "required": [
    "schemaVersion",
    "parts",
  ],
  "title": "ContentParts",
  "type": "object",
}
`;

exports[`schema snapshots (breaking-change detection) > contextManifest matches its committed snapshot 1`] = `
{
  "$id": "https://chatbot-contracts.appspine.internal/v1/context-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable, hash-addressed reference to the bounded conversation context a Run was dispatched with (024 plan §6.3). Never carries full prompt text — only fixed IDs/revisions and a manifest hash.",
  "properties": {
    "attachmentRefs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attachmentId": {
            "$ref": "common.schema.json#/$defs/uuid",
          },
          "checksumSha256": {
            "$ref": "common.schema.json#/$defs/sha256Hex",
          },
        },
        "required": [
          "attachmentId",
          "checksumSha256",
        ],
        "type": "object",
      },
      "maxItems": 50,
      "type": "array",
    },
    "cutoffMessageId": {
      "$ref": "common.schema.json#/$defs/uuid",
      "description": "The trigger message/action ID this manifest is bounded by. Nothing with a later sequence is included.",
    },
    "generatedAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp",
    },
    "locale": {
      "$ref": "common.schema.json#/$defs/locale",
    },
    "manifestHash": {
      "$ref": "common.schema.json#/$defs/sha256Hex",
    },
    "messageRefs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "messageId": {
            "$ref": "common.schema.json#/$defs/uuid",
          },
          "revisionId": {
            "$ref": "common.schema.json#/$defs/uuid",
          },
          "sequence": {
            "minimum": 0,
            "type": "integer",
          },
        },
        "required": [
          "messageId",
          "revisionId",
          "sequence",
        ],
        "type": "object",
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array",
    },
    "rootMessageId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/contractVersion",
    },
    "summarizedThroughMessageId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        {
          "type": "null",
        },
      ],
    },
    "summaryRevision": {
      "description": "null when no summary applies yet.",
      "minimum": 0,
      "type": [
        "integer",
        "null",
      ],
    },
    "threadId": {
      "$ref": "common.schema.json#/$defs/uuid",
    },
    "timezone": {
      "$ref": "common.schema.json#/$defs/ianaTimezone",
    },
  },
  "required": [
    "schemaVersion",
    "threadId",
    "rootMessageId",
    "cutoffMessageId",
    "messageRefs",
    "summaryRevision",
    "attachmentRefs",
    "locale",
    "timezone",
    "generatedAt",
    "manifestHash",
  ],
  "title": "ContextManifest",
  "type": "object",
}
`;

exports[`schema snapshots (breaking-change detection) > ingressAcceptance matches its committed snapshot 1`] = `
{
  "$defs": {
    "accepted": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": true,
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/contractVersion",
        },
      },
      "required": [
        "schemaVersion",
        "requestId",
        "runId",
        "accepted",
      ],
      "type": "object",
    },
    "rejected": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": false,
        },
        "rejectionReason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/contractVersion",
        },
      },
      "required": [
        "schemaVersion",
        "requestId",
        "runId",
        "accepted",
        "rejectionReason",
      ],
      "type": "object",
    },
  },
  "$id": "https://chatbot-contracts.appspine.internal/v1/ingress-acceptance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "n8n's immediate 2xx/202 response to an IngressRequest. Acknowledges receipt only — the final result always arrives later via the completion callback (024 plan §6.1).",
  "oneOf": [
    {
      "$ref": "#/$defs/accepted",
    },
    {
      "$ref": "#/$defs/rejected",
    },
  ],
  "title": "IngressAcceptance",
}
`;

