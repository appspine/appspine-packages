{
  "name": "@appspine/notification",
  "version": "0.2.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appspine/appspine.git",
    "directory": "packages/notification"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@appspine/common": "^0.3.2",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@appspine/common": "workspace:*",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@prisma/client": "^6.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
