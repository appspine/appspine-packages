        "runId",
        "status",
        "deadlineAt",
      ],
      "type": "object",
    },
    "notClaimed": {
      "additionalProperties": false,
      "properties": {
        "deadlineAt": {
          "$ref": "common.schema.json#/$defs/utcTimestamp",
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/contractVersion",
        },
        "status": {
          "enum": [
            "ALREADY_CLAIMED",
            "EXPIRED",
            "INVALID",
          ],
          "type": "string",
        },
      },
      "required": [
        "schemaVersion",
        "runId",
        "status",
        "deadlineAt",
        "reason",
      ],
      "type": "object",
    },
  },
  "$id": "https://chatbot-contracts.appspine.internal/v1/claim-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Only the first successful claim for a Run may proceed to model/tool execution (024 plan §7.1/§7.3).",
  "oneOf": [
    {
      "$ref": "#/$defs/claimed",
    },
    {
      "$ref": "#/$defs/notClaimed",
    },
  ],
  "title": "ClaimResponse",
}
`;

exports[`schema snapshots (breaking-change detection) > common matches its committed snapshot 1`] = `
{
  "$defs": {
    "contractVersion": {
      "description": "chatbot-contracts schemaVersion, semver-like (major.minor.patch). A breaking change bumps major.",
      "maxLength": 20,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string",
    },
    "deploymentRevisionSnapshot": {
      "additionalProperties": false,
      "description": "Immutable snapshot of the Deployment identity a Run was pinned to at dispatch time.",
      "properties": {
        "contractVersion": {
          "$ref": "#/$defs/contractVersion",
        },
        "declaredModel": {
          "$ref": "#/$defs/nonEmptyString",
        },
        "declaredModelProvider": {
          "$ref": "#/$defs/nonEmptyString",
        },
        "deploymentId": {
          "$ref": "#/$defs/uuid",
        },
        "workflowKey": {
          "$ref": "#/$defs/nonEmptyString",
        },
        "workflowRevision": {
          "$ref": "#/$defs/nonEmptyString",
        },
        "wrapperRevision": {
          "$ref": "#/$defs/nonEmptyString",
        },
      },
      "required": [
        "deploymentId",
        "workflowKey",
        "workflowRevision",
        "wrapperRevision",
        "contractVersion",
      ],
      "type": "object",
    },
    "httpsUrl": {
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://",
      "type": "string",
    },
    "ianaTimezone": {
      "description": "IANA time zone database name (e.g. Asia/Taipei, UTC).",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(UTC|Etc/UTC|[A-Za-z_+-]+(/[A-Za-z0-9_+-]+)+)$",
      "type": "string",
    },
    "locale": {
      "description": "BCP 47 language tag, e.g. en, en-US, zh-TW.",
      "maxLength": 35,
      "minLength": 2,
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "type": "string",
    },
    "nonEmptyString": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string",
    },
    "opaqueCapabilityToken": {
      "description": "Short-lived, run-scoped capability token. Opaque to the schema; never logged, never rendered to a client.",
      "maxLength": 2048,
      "minLength": 16,
      "type": "string",
    },
    "sha256Hex": {
      "description": "Lowercase hex-encoded SHA-256 digest, exactly 64 characters.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string",
    },
    "trustedOrigin": {
      "description": "Server-controlled message/actor origin. Only USER_UI may ever appear as a *trigger* origin (see ingress-request.schema.json) — this enum exists for completion/context/audit payloads that legitimately reference other origins after the fact.",
      "enum": [
        "USER_UI",
        "CHAT_BOT",
        "INCOMING_WEBHOOK",
        "MCP",
        "SYSTEM",
      ],
      "type": "string",
    },
    "utcTimestamp": {
      "description": "Server-generated UTC timestamp, RFC 3339 with a literal Z offset.",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "Z$",
      "type": "string",
    },
    "uuid": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "type": "string",
    },
  },
  "$id": "https://chatbot-contracts.appspine.internal/v1/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common definitions shared by all chatbot-contracts schemas",
}
`;

exports[`schema snapshots (breaking-change detection) > completion matches its committed snapshot 1`] = `
{
  "$defs": {
    "failed": {
      "additionalProperties": false,
      "properties": {
        "completedAt": {
          "$ref": "common.schema.json#/$defs/utcTimestamp",
        },
        "deploymentId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256Hex",
        },
        "error": {
          "$ref": "structured-error.schema.json#",
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString",
        },
        "replyText": {
          "description": "Safe fallback text explaining the failure to the end user.",
          "maxLength": 8000,
          "type": "string",
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/contractVersion",
        },
        "status": {
          "const": "FAILED",
        },
      },
      "required": [
        "schemaVersion",
        "requestId",
        "runId",
        "deploymentId",
        "executionId",
        "status",
        "replyText",
        "error",
        "digest",
        "completedAt",
      ],
      "type": "object",
    },
    "succeeded": {
      "additionalProperties": false,
      "properties": {
        "attachmentIds": {
          "items": {
            "$ref": "common.schema.json#/$defs/uuid",
          },
          "maxItems": 20,
          "type": "array",
        },
        "completedAt": {
          "$ref": "common.schema.json#/$defs/utcTimestamp",
        },
        "contentParts": {
          "$ref": "content-parts.schema.json#",
        },
        "deploymentId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256Hex",
          "description": "sha256 over the canonical result payload. Same digest on retry -> return the original result. Different digest for the same runId -> reject and alert (024 plan §6.4).",
        },
        "executionId": {
          "$ref": "common.schema.json#/$defs/nonEmptyString",
        },
        "replyText": {
          "description": "Fallback plain-text reply for every client, even when contentParts is present.",
          "maxLength": 8000,
          "type": "string",
        },
        "requestId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/uuid",
        },
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/contractVersion",
        },
        "status": {
          "const": "SUCCEEDED",
        },
        "summaryUpdate": {
          "additionalProperties": false,
          "properties": {
            "revision": {
              "minimum": 0,
              "type": "integer",
            },
            "summarizedThroughMessageId": {
              "$ref": "common.schema.json#/$defs/uuid",
            },
            "text": {
              "maxLength": 24000,
              "type": "string",
            },
          },
          "required": [
            "revision",
            "summarizedThroughMessageId",
            "text",
          ],
          "type": "object",
        },
        "usage": {
          "additionalProperties": false,
          "properties": {
            "completionTokens": {
              "minimum": 0,
              "type": "integer",
            },
            "modelCallCount": {
              "minimum": 0,
              "type": "integer",
            },
            "promptTokens": {
              "minimum": 0,
              "type": "integer",
            },
            "toolCallCount": {
              "minimum": 0,
              "type": "integer",
            },
          },
          "type": "object",
        },
      },
      "required": [
        "schemaVersion",
        "requestId",
        "runId",
        "deploymentId",
        "executionId",
        "status",
        "replyText",
        "digest",
        "completedAt",
      ],
      "type": "object",
    },
  },
  "$id": "https://chatbot-contracts.appspine.internal/v1/completion.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "n8n -> Chat authenticated completion callback (024 plan §6.4). Bound to a single Run via a short-lived capability; digest reuse makes retries idempotent.",
  "oneOf": [
    {
      "$ref": "#/$defs/succeeded",
    },
    {
      "$ref": "#/$defs/failed",
    },
  ],
  "title": "CompletionCallback",
}
`;

